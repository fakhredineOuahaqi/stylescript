# ---------- Frontend (Next.js) ----------
# Public site title
NEXT_PUBLIC_SITE_TITLE=Shop Demo

# Backend base URL (include backend base path, no trailing slash)
# Example local: http://localhost:3001/BACKEND_PROJ_d6d2bb86_snap_20260304_033524_835
# Example prod:  https://stylescript-api.onrender.com/BACKEND_PROJ_d6d2bb86_snap_20260304_033524_835
NEXT_PUBLIC_API_BASE_URL=

# Optional: explicit entities endpoint override (highest priority)
# Example: https://stylescript-api.onrender.com/BACKEND_PROJ_d6d2bb86_snap_20260304_033524_835/api/entities
NEXT_PUBLIC_ENTITIES_ENDPOINT=

# Optional: backend base path if NEXT_PUBLIC_API_BASE_URL is not provided
NEXT_PUBLIC_BACKEND_BASE_PATH=/BACKEND_PROJ_d6d2bb86_snap_20260304_033524_835

# Optional base path for static hosting under subpath
NEXT_PUBLIC_BASE_PATH=

# Optional Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudinary Upload Widget
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------- Backend (Express/Prisma) ----------
# Required DB URL
DATABASE_URL=mysql://user:password@host:3306/database

# Backend route base path mounted before /api/entities
BACKEND_BASE_PATH=/BACKEND_PROJ_d6d2bb86_snap_20260304_033524_835

# Backend port
PORT=3001

# Comma-separated CORS allowlist (recommended in production)
# Example: https://stylescript-frontend.onrender.com,http://localhost:3000
CORS_ORIGIN=
