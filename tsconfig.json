{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@repo/shadcn-ui/lib/utils": [
        "./src/lib/utils"
      ],
      "@repo/shadcn-ui/components/ui/*": [
        "./src/components/ui/*"
      ],
      "@repo/*": [
        "./src/components/ui/shadcn-io/*"
      ],
      "@/server/*": [
        "./server/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "strict": false,
    "types": [
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "checkpoint",
    "pnpm_node_modules",
    "prisma-generated",
    "server"
  ]
}
