// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../prisma-generated/client"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:pzprod@mysql.pzprod:3306/proj_d6d2bb86"
}

enum order_status {
  pending
  confirmed
  shipped
  delivered
  cancelled
  refunded
}

enum payment_method {
  cash_on_delivery
  credit_card
  bank_transfer
}

enum user_role {
  customer
  admin
  super_admin
}

enum user_status {
  active
  suspended
  deleted
}

enum product_status {
  active
  inactive
  out_of_stock
}

model user {
  id             Int            @id @default(autoincrement())
  username       String         @unique @db.VarChar(255)
  email          String         @unique @db.VarChar(255)
  password       String         @db.VarChar(255)
  phone_number   String?        @db.VarChar(50)
  avatar_url     String?        @db.VarChar(1024)
  role           user_role      @default(customer)
  status         user_status    @default(active)
  last_login     DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  carts          cart[]
  orders         order[]
  user_addresses user_address[]
  reviews        review[]
}

model admin_user {
  id         Int         @id @default(autoincrement())
  username   String      @unique @db.VarChar(255)
  email      String      @unique @db.VarChar(255)
  password   String      @db.VarChar(255)
  role       user_role   @default(admin)
  status     user_status @default(active)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
}

model category {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  description     String?   @db.Text
  cover_image_url String?   @db.VarChar(1024)
  is_visible      Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  products        product[]
}

model product {
  id                Int            @id @default(autoincrement())
  title             String         @db.VarChar(500)
  name              String         @db.VarChar(500)
  sku               String         @unique @db.VarChar(100)
  description_short String?        @db.Text
  description_long  String?        @db.LongText
  price             Decimal        @db.Decimal(10, 2)
  sale_price        Decimal?       @db.Decimal(10, 2)
  compare_at_price  Decimal?       @db.Decimal(10, 2)
  cover_image_url   String?        @db.VarChar(1024)
  hover_image_url   String?        @db.VarChar(1024)
  image_url_list    String?        @db.Text
  stock_quantity    Int            @default(0)
  available_sizes   String?        @db.VarChar(500)
  available_colors  String?        @db.VarChar(500)
  material_info     String?        @db.Text
  care_instructions String?        @db.Text
  size_chart_url    String?        @db.VarChar(1024)
  status            product_status @default(active)
  category_id       Int
  category          category       @relation(fields: [category_id], references: [id])
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  cart_items        cart_item[]
  order_items       order_item[]
  reviews           review[]
}

model cart {
  id             Int         @id @default(autoincrement())
  user_id        Int
  subtotal_price Decimal     @default(0) @db.Decimal(10, 2)
  total_price    Decimal     @default(0) @db.Decimal(10, 2)
  shipping_fee   Decimal     @default(0) @db.Decimal(10, 2)
  user           user        @relation(fields: [user_id], references: [id])
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  cart_items     cart_item[]
}

model cart_item {
  id             Int      @id @default(autoincrement())
  cart_id        Int
  product_id     Int
  quantity       Int      @default(1)
  unit_price     Decimal  @db.Decimal(10, 2)
  selected_size  String?  @db.VarChar(50)
  selected_color String?  @db.VarChar(50)
  cart           cart     @relation(fields: [cart_id], references: [id])
  product        product  @relation(fields: [product_id], references: [id])
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model order {
  id               Int            @id @default(autoincrement())
  order_number     String         @unique @db.VarChar(100)
  user_id          Int
  status           order_status   @default(pending)
  payment_method   payment_method @default(cash_on_delivery)
  total_amount     Decimal        @db.Decimal(10, 2)
  total_price      Decimal        @db.Decimal(10, 2)
  shipping_fee     Decimal        @default(0) @db.Decimal(10, 2)
  shipping_name    String         @db.VarChar(255)
  shipping_phone   String         @db.VarChar(50)
  shipping_address String         @db.VarChar(1000)
  shipping_city    String?        @db.VarChar(100)
  tracking_number  String?        @db.VarChar(255)
  refund_reason    String?        @db.Text
  user             user           @relation(fields: [user_id], references: [id])
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  order_items      order_item[]
}

model order_item {
  id                      Int      @id @default(autoincrement())
  order_id                Int
  product_id              Int
  product_title           String   @db.VarChar(500)
  product_cover_image_url String?  @db.VarChar(1024)
  quantity                Int
  unit_price              Decimal  @db.Decimal(10, 2)
  price_at_purchase       Decimal  @db.Decimal(10, 2)
  selected_size           String?  @db.VarChar(50)
  selected_color          String?  @db.VarChar(50)
  order                   order    @relation(fields: [order_id], references: [id])
  product                 product  @relation(fields: [product_id], references: [id])
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

model user_address {
  id             Int      @id @default(autoincrement())
  user_id        Int
  recipient_name String   @db.VarChar(255)
  phone_number   String   @db.VarChar(50)
  address_line_1 String   @db.VarChar(500)
  address_line_2 String?  @db.VarChar(500)
  city           String   @db.VarChar(100)
  postal_code    String?  @db.VarChar(20)
  zip_code       String?  @db.VarChar(20)
  is_default     Boolean  @default(false)
  user           user     @relation(fields: [user_id], references: [id])
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model review {
  id           Int      @id @default(autoincrement())
  product_id   Int
  user_id      Int
  user_name    String   @db.VarChar(255)
  rating_value Int
  comment_text String?  @db.Text
  product      product  @relation(fields: [product_id], references: [id])
  user         user     @relation(fields: [user_id], references: [id])
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model promotion {
  id                   Int      @id @default(autoincrement())
  title                String   @db.VarChar(500)
  subtitle             String?  @db.VarChar(500)
  background_image_url String?  @db.VarChar(1024)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}
